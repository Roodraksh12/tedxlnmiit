---
import MainHead from "./MainHead.astro";
import Footer from "../components/Footer.jsx";
import "../styles/global.css";
import NavWrapper from "../components/NavWrapper.jsx";
import DotGrid from "../components/DotGrid.jsx";

const { title = "Default Title", description = "Default Description" } =
  Astro.props;
---

<html lang="en">
  <head>
  <MainHead
    title={title}
    description={description}
    canonical={Astro.url.href}
  />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VMRFWPCG0X"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-VMRFWPCG0X', {
    send_page_view: true
  });
</script>


</head>
  <body class="bg-black text-white overflow-x-hidden min-h-screen relative">

    
    <div
      id="site-loader"
      class="fixed inset-0 z-[9999] flex items-center justify-center bg-white"
    >
      <div class="flex flex-col items-center gap-10">
        <span class="text-3xl font-extrabold tracking-widest text-black">
          <span class="text-red-600">TEDx</span>LNMIIT
        </span>
        <div class="loader"></div>
      </div>
    </div>
    
    <div class="fixed inset-0 -z-10 pointer-events-none">
      <DotGrid
        client:load
        dotSize={6}
        gap={15}
        baseColor="#212020"
        activeColor="#636161"
        proximity={125}
        shockRadius={150}
        shockStrength={4}
        resistance={500}
        returnDuration={1.0}
      />
    </div>
    <!-- ================= END BACKGROUND ================= -->

    <NavWrapper client:load />

    <!-- ================= PAGE CONTENT ================= -->
    <div
      id="page-transition"
      class="opacity-0 translate-y-4 transition-all duration-700 ease-out min-h-screen pt-20"
    >
      <main>
        <slot />
      </main>
    </div>
    <!-- ================= END PAGE CONTENT ================= -->

    <Footer client:visible />

    <!-- ================= SCRIPT ================= -->
    <script type="module">
      if (typeof window !== "undefined") {
        const MIN_LOADER_TIME = 2500;

        window.addEventListener("DOMContentLoaded", () => {
          const loader = document.getElementById("site-loader");
          const page = document.getElementById("page-transition");

          /* -------- Detect navigation type -------- */
          const navEntry = performance.getEntriesByType("navigation")[0];
          const isReload = navEntry?.type === "reload";

          const hasSeenLoader = sessionStorage.getItem("hasSeenLoader");

          const shouldShowLoader = !hasSeenLoader || isReload;

          if (shouldShowLoader && loader) {
            sessionStorage.setItem("hasSeenLoader", "true");

            // lock scroll
            document.body.style.overflow = "hidden";

            loader.classList.remove("hidden");

            const start = performance.now();

            window.addEventListener("load", () => {
              const elapsed = performance.now() - start;
              const remaining = Math.max(0, MIN_LOADER_TIME - elapsed);

              setTimeout(() => {
                loader.style.transition = "opacity 500ms ease";
                loader.style.opacity = "0";

                setTimeout(() => {
                  loader.remove();
                  document.body.style.overflow = "";
                  revealPage();
                }, 500);
              }, remaining);
            });
          } else {
            loader?.remove();
            revealPage();
          }

          function revealPage() {
            requestAnimationFrame(() => {
              page.classList.remove("opacity-0", "translate-y-4");
              page.classList.add("opacity-100", "translate-y-0");
            });
          }

          /* -------- Internal navigation fade -------- */
          document.querySelectorAll("a[href]").forEach((link) => {
            try {
              const href = link.getAttribute("href");
              if (
                !href ||
                href.startsWith("#") ||
                href.startsWith("mailto:") ||
                href.startsWith("tel:")
              )
                return;

              const linkUrl = new URL(href, location.href);
              if (linkUrl.origin !== location.origin) return;

              link.addEventListener("click", (e) => {
                if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
                if (link.target && link.target !== "_self") return;

                e.preventDefault();
                page.classList.add("opacity-0", "translate-y-4");

                setTimeout(() => {
                  location.assign(linkUrl.href);
                }, 450);
              });
            } catch {}
          });
        });
      }
    </script>
    <!-- ================= END SCRIPT ================= -->

  </body>
</html>
