---
import Ticket from './Ticket.jsx';
---
<section id="book-tickets" class="ticket-invite" data-ticket-invite aria-label="Tickets and registration">
  <div id="ticket-prices" class="ticket-destination" tabindex="-1" aria-label="Ticket registration"></div>
  <div class="ticket-invite-stage">
    <div class="ticket-backdrop" aria-hidden="true"></div>
    <div class="ticket-landing">
      <header class="ticket-heading"><p>TAKE YOUR SEAT</p><h2>ONE PASS.<br class="mobile-break" /> A DAY OF IDEAS.</h2></header>
      <div class="ticket-reveal"><Ticket /></div>
      <p class="ticket-footnote">10 JANUARY 2027 <span aria-hidden="true">/</span> LNMIIT, JAIPUR</p>
    </div>
    <a class="ticket-invite-title" href="#ticket-prices" data-ticket-transition aria-label="Book your ticket now">
      <svg class="ticket-lettering" aria-hidden="true" width="100%" height="100%"><g data-ticket-lettering><text x="0" y="0">BOOK YOUR TICKET NOW</text></g></svg>
    </a>
    <div class="ticket-dot" aria-hidden="true"></div>
    <div class="ticket-scroll-cue" aria-hidden="true"><span>EVERY IDEA STARTS WITH A DOT.</span><span class="ticket-scroll-line"></span><span>SCROLL TO TAKE YOUR SEAT</span></div>
  </div>
</section>
<dialog id="ticket-registration" class="ticket-registration" aria-labelledby="ticket-registration-title">
  <header>
    <h2 id="ticket-registration-title">Ticket registration</h2>
    <button type="button" data-close-registration aria-label="Close registration" autofocus>×</button>
  </header>
  <form id="lnmiit-registration" class="native-registration" method="dialog" hidden>
    <p role="status">Preview only. Registration and payment collection are disabled.</p>
    <fieldset>
      <legend>Attendee details</legend>
      <label>Full name <input name="name" autocomplete="name" required /></label>
      <label>LNMIIT email <input type="email" name="email" autocomplete="email" required /></label>
      <label>Phone number <input type="tel" name="phone" autocomplete="tel" required /></label>
      <label>Attendee type
        <select name="attendeeType" required><option value="">Select your role</option><option>Student</option><option>Staff</option></select>
      </label>
      <label>Roll number or staff ID <input name="instituteId" required /></label>
    </fieldset>
    <fieldset>
      <legend>Payment details</legend>
      <p>One pass · ₹499</p>
      <label>Payment reference <input name="paymentReference" required /></label>
      <label>Payment screenshot <input type="file" name="paymentScreenshot" accept="image/png,image/jpeg,image/webp" required /></label>
    </fieldset>
    <p>Questions? Email <a href="mailto:tedxlnmiit@lnmiit.ac.in">tedxlnmiit@lnmiit.ac.in</a>.</p>
    <button class="native-submit" type="submit" disabled>Submit registration</button>
  </form>
  <iframe hidden title="TEDxLNMIIT ticket registration" width="760" height="1000" referrerpolicy="strict-origin-when-cross-origin"></iframe>
</dialog>
<section class="ticket-inclusions" aria-labelledby="ticket-inclusions-title">
  <div><p class="ticket-eyebrow">MORE THAN A SEAT</p><h2 id="ticket-inclusions-title">Come for the talks.<br />Leave with a new perspective.</h2></div>
  <ul><li>Access to all talks &amp; storytelling sessions</li><li>Conversations with a community of change-makers</li><li>Curated meals &amp; refreshments</li><li>Attendee goodies &amp; your official TEDx badge</li></ul>
</section>
<style>
.ticket-registration{position:fixed;inset:0;width:min(960px,calc(100% - 24px));max-width:none;max-height:calc(100dvh - 24px);margin:auto;padding:16px;border:1px solid #ffffff30;border-radius:14px;background:#141014;color:#f5f2eb}
.ticket-registration::backdrop{background:#000c}
.ticket-registration header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}
.ticket-registration h2{font-size:clamp(1rem,3vw,1.7rem);margin:0}
.ticket-registration button{min-width:44px;min-height:44px;font-size:24px;cursor:pointer}
.ticket-registration [hidden]{display:none!important}
.native-registration{display:grid;gap:16px}
.native-registration fieldset{display:grid;gap:12px;border:1px solid #ffffff30;padding:16px;border-radius:8px}
.native-registration legend{padding-inline:6px;font-weight:700}
.native-registration label{display:grid;gap:5px}
.native-registration input,.native-registration select{width:100%;padding:10px;background:#211a20;color:#fff;border:1px solid #ffffff45;border-radius:6px}
.native-registration .native-submit{font-size:1rem;color:#c7bfc7;border:1px solid #ffffff30;border-radius:8px;cursor:default}
.ticket-registration iframe{display:block;width:100%;height:min(76dvh,1000px);border:0;border-radius:8px;background:#fff}
.ticket-invite { --nav-space:var(--site-header-height); --stage-height:calc(100svh - var(--nav-space)); position:relative; width:100%; isolation:isolate; color:#f5f2eb; }
.ticket-invite-stage { position:relative; display:flex; align-items:center; justify-content:center; min-height:620px; padding:60px 24px; overflow:clip; }
.ticket-destination { position:absolute; top:0; left:0; width:1px; height:1px; scroll-margin-top:var(--nav-space); }
.ticket-backdrop { position:absolute; inset:0; background:color-mix(in srgb,var(--site-background) 32%,transparent); opacity:1; z-index:-1; pointer-events:none; }
.ticket-landing { width:min(960px,100%); position:relative; z-index:1; }
.ticket-heading { text-align:center; margin-bottom:32px; }
.ticket-heading p,.ticket-footnote,.ticket-eyebrow { font:10px/1.5 ui-monospace,monospace; letter-spacing:.18em; }
.ticket-heading p { color:var(--color-tedx); margin-bottom:12px; }
.ticket-heading h2 { font-size:clamp(26px,4vw,52px); line-height:1.05; letter-spacing:-.055em; font-weight:700; }
.mobile-break { display:none; }
.ticket-footnote { text-align:center; margin-top:24px; color:#aaa3a5; font-size:9px; }
.ticket-footnote span { padding:0 16px; color:var(--color-tedx); }
.ticket-invite-title { display:none; position:absolute; inset:0; z-index:3; }
.ticket-invite-title:focus-visible { outline:2px solid #f5f2eb; outline-offset:-12px; }
.ticket-lettering { display:block; overflow:visible; }
.ticket-lettering text { font-family:var(--font-primary); font-size:100px; font-weight:600; letter-spacing:-5.5px; fill:#f5f2eb; text-rendering:geometricPrecision; }
.ticket-dot { position:absolute; z-index:2; left:0; top:0; width:110px; height:110px; background:var(--color-tedx); border-radius:50%; pointer-events:none; display:none; }
.ticket-scroll-cue { display:none; position:absolute; bottom:28px; left:0; right:0; text-align:center; font:8px/1.5 ui-monospace,monospace; letter-spacing:.17em; color:#aba2a5; pointer-events:none; z-index:3; }
.ticket-scroll-line { display:block; width:1px; height:28px; background:var(--color-tedx); margin:12px auto; }
.is-scroll-invite { height:280svh; }
.is-scroll-invite .ticket-destination { top:calc(100% - var(--stage-height)); }
.is-scroll-invite .ticket-invite-stage { height:var(--stage-height); min-height:0; position:sticky; top:var(--nav-space); padding:24px 40px; }
:is(.is-scroll-invite,.is-ticket-playing) :is(.ticket-invite-title,.ticket-dot,.ticket-scroll-cue) { display:block; }
:is(.is-scroll-invite,.is-ticket-playing) .ticket-reveal { clip-path:circle(0 at 50% 50%); }
:is(.is-scroll-invite,.is-ticket-playing) :is(.ticket-heading,.ticket-footnote,.ticket-backdrop) { opacity:0; }
:is(.is-scroll-invite,.is-ticket-playing) :is(:global(.admission-main),:global(.admission-stub)) { opacity:var(--ticket-details,0); }
.ticket-inclusions { display:grid; grid-template-columns:1fr 1fr; gap:70px; max-width:1040px; margin:0 auto; padding:88px 40px 100px; }
.ticket-eyebrow { color:var(--color-tedx); margin-bottom:18px; }
.ticket-inclusions h2 { font-size:clamp(24px,3vw,36px); line-height:1.25; letter-spacing:-.04em; font-weight:500; }
.ticket-inclusions ul { list-style:none; padding:0; }
.ticket-inclusions li { padding:15px 0; border-bottom:1px solid #ffffff20; color:#c7c0c3; font-size:13px; }
.ticket-inclusions li::before { content:'↗'; color:var(--color-tedx); margin-right:14px; }
@media(max-width:700px) {
  .is-scroll-invite { height:240svh; }.ticket-invite-stage { padding:40px 20px; min-height:0; }.is-scroll-invite .ticket-invite-stage { padding:16px 20px; }
  .ticket-heading { margin-bottom:22px; }.ticket-heading h2 { font-size:clamp(25px,6.5vw,40px); }.ticket-heading p { font-size:8px; margin-bottom:10px; }
  .ticket-footnote { margin-top:18px; font-size:8px; letter-spacing:.1em; }.ticket-scroll-cue { font-size:7px; bottom:24px; }.ticket-inclusions { grid-template-columns:1fr; gap:30px; padding:55px 24px 65px; }
}
@media(max-width:380px) { .mobile-break { display:block; }.ticket-footnote span { padding:0 7px; } }
</style>
<script>
import '../scripts/ticket-invite';

const registration = document.querySelector<HTMLDialogElement>('#ticket-registration');
const form = registration?.querySelector('iframe');
const title = registration?.querySelector('h2');
const nativeForm = registration?.querySelector<HTMLFormElement>('#lnmiit-registration');
const choices = document.querySelectorAll<HTMLButtonElement>('[data-registration-src], [data-registration-native]');

if (registration && form && title && nativeForm) {
  nativeForm.addEventListener('submit', event => event.preventDefault());
  registration.querySelector('[data-close-registration]')?.addEventListener('click', () => registration.close());
  registration.addEventListener('close', () => {
    for (const choice of choices) choice.setAttribute('aria-expanded', 'false');
  });
  for (const button of choices) {
    button.addEventListener('click', () => {
      const source = button.dataset.registrationSrc;
      const isNative = button.hasAttribute('data-registration-native');
      nativeForm.hidden = !isNative;
      form.hidden = isNative;
      if (source && form.getAttribute('src') !== source) form.src = source;
      const category = button.textContent?.trim();
      title.textContent = `Ticket registration · ${category}`;
      form.title = `TEDxLNMIIT registration for ${category}`;
      registration.showModal();
      for (const choice of choices) choice.setAttribute('aria-expanded', String(choice === button));
    });
  }
}
</script>
