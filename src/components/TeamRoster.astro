---
import { faculty } from "../data/faculty.js";
import { teamGroups } from "../data/team-roster.js";
import TeamTabsGlass from "./TeamTabsGlass.jsx";

const tabs = Object.keys(teamGroups);
const { name, image, linkedin } = faculty[0];
---

<section class="team-roster" aria-labelledby="team-roster-heading">
  <header class="team-roster-header">
    <h1 id="team-roster-heading">The team</h1>
    <TeamTabsGlass client:load>
      {tabs.map((label, index) => (
        <button
          id={`team-roster-tab-${index + 1}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls="team-roster-panel"
          tabindex={index === 0 ? 0 : -1}
        >
          <span class="team-roster-tab-highlight" data-glass-highlight={index === 0 ? "" : undefined} aria-hidden="true"></span>
          <span class="team-roster-tab-label">{label}</span>
        </button>
      ))}
    </TeamTabsGlass>
  </header>

  <div class="team-roster-panel" id="team-roster-panel" role="tabpanel" aria-labelledby="team-roster-tab-1">
    <div class="team-roster-lists">
      {Object.values(teamGroups).map((members, listIndex) => (
        <ul class="team-roster-list" data-dense={members.length >= 5 ? "" : undefined} style={{ "--member-count": members.length }} aria-label={tabs[listIndex]} hidden={listIndex !== 0}>
          {members.map((member, index) => (
            <li>
              <button
                type="button"
                class="team-roster-row team-roster-member"
                aria-label={`${member.name}, ${member.role.join(", ")}`}
                aria-current={index === 0 ? "true" : undefined}
              >
                <svg class="team-roster-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 12h15m-6-6 6 6-6 6" />
                </svg>
                {(
                  <>
                    <span class="team-roster-member-name" aria-hidden="true">
                      {member.name.split(" ").map((word) => (
                        <span class="team-roster-word">
                          {Array.from(word, (letter) => (
                            <span class="team-roster-segment"><i data-letter={letter}>{letter}</i></span>
                          ))}
                        </span>
                      ))}
                    </span>
                    <span class="team-roster-member-role" aria-hidden="true">
                      {member.role.map((role) => <span>{role}</span>)}
                    </span>
                  </>
                )}
              </button>
            </li>
          ))}
        </ul>
      ))}
    </div>

    <div class="team-roster-feature">
      <div class="team-roster-picture">
        <div class="team-roster-portrait" role="img" aria-label={`Portrait of ${name}`}>
          <div class="team-roster-image" aria-hidden="true"><img src={image} alt="" fetchpriority="high" /></div>
        </div>
        <a class="team-roster-profile" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${name} on LinkedIn (opens in a new tab)`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 8.25A1.75 1.75 0 1 0 6 4.75a1.75 1.75 0 0 0 0 3.5ZM4.5 10h3v9.5h-3V10Zm5.5 0h2.9v1.3a3.4 3.4 0 0 1 3-1.55c3.15 0 3.6 2.08 3.6 4.78v4.97h-3v-4.4c0-1.06-.02-2.42-1.5-2.42s-1.99 1.16-1.99 2.35v4.47H10V10Z" /></svg>
        </a>
      </div>
      <template class="team-roster-placeholder">
        <div class="team-roster-image" data-tone="0" aria-hidden="true">
          <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="60" cy="43" r="16" />
            <path d="M30 90v-4a22 22 0 0 1 22-22h16a22 22 0 0 1 22 22v4" />
          </svg>
        </div>
      </template>
      <div class="team-roster-navigation" aria-label="Browse members" role="group">
        <button type="button" data-step="-1" aria-label="Previous member">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 12H5m6-6-6 6 6 6" /></svg>
        </button>
        <button type="button" data-step="1" aria-label="Next member">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { faculty } from "../data/faculty.js";

  const roster = document.querySelector(".team-roster");

  if (roster) {
    const tabs = Array.from(roster.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panel = roster.querySelector<HTMLElement>(".team-roster-panel")!;
    const list = roster.querySelector<HTMLElement>(".team-roster-lists")!;
    const lists = Array.from(list.querySelectorAll<HTMLUListElement>(".team-roster-list"));
    const rowSets = lists.map((group) =>
      Array.from(group.querySelectorAll<HTMLButtonElement>(".team-roster-row")),
    );
    const portrait = roster.querySelector<HTMLElement>(".team-roster-portrait")!;
    const profile = roster.querySelector<HTMLAnchorElement>(".team-roster-profile")!;
    const template = roster.querySelector<HTMLTemplateElement>(".team-roster-placeholder")!
      .content.firstElementChild as HTMLElement;
    const facultyImages = faculty.map(({ image }) => {
      const photo = new Image();
      photo.src = image;
      photo.alt = "";
      return photo;
    });
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const easeOut = "cubic-bezier(.2,.72,.3,1)";
    // Sampled from the reference wipe at 40 ms intervals.
    const wipeFrames = [0, .13, .31, .48, .68, .75, .81, .86, .9, .94, .96, .97, .98, .99, 1]
      .map((coverage) => ({ clipPath: `inset(0 0 ${100 * (1 - coverage)}% 0)` }));
    let selectedTab = 0;
    let displayedTab = 0;
    let selectedRow = 0;
    let portraitTone = 0;
    let portraitRequest = 0;
    let listMotion: Animation | undefined;

    function showPortrait(next: HTMLElement) {
      if (reducedMotion.matches) {
        portrait.replaceChildren(next);
        return;
      }

      const previous = Array.from(portrait.children);
      portrait.append(next);
      const wipe = next.animate(wipeFrames, { duration: 560, fill: "both" });
      wipe.onfinish = () => {
        previous.forEach((layer) => layer.remove());
        wipe.cancel();
      };
    }

    function selectRow(index: number, force = false) {
      if (selectedRow === index && !force) return;
      selectedRow = index;
      const rows = rowSets[displayedTab];
      rows.forEach((row, position) => {
        if (position === index) row.setAttribute("aria-current", "true");
        else row.removeAttribute("aria-current");
      });

      const next = template.cloneNode(true) as HTMLElement;
      const request = ++portraitRequest;
      const member = displayedTab === 0 ? faculty[index] : undefined;
      if (member) {
        const photo = facultyImages[index].cloneNode() as HTMLImageElement;
        profile.href = member.linkedin;
        profile.setAttribute("aria-label", `${member.name} on LinkedIn (opens in a new tab)`);
        profile.hidden = false;
        portrait.setAttribute("aria-label", `Portrait of ${member.name}`);

        void photo.decode().then(() => {
          if (request !== portraitRequest) return;
          next.replaceChildren(photo);
          showPortrait(next);
        }, () => {
          if (request !== portraitRequest) return;
          portrait.setAttribute("aria-label", `Portrait unavailable for ${member.name}`);
          showPortrait(next);
        });
      } else {
        const tone = (displayedTab + index) % 4;
        portraitTone = tone === portraitTone ? (tone + 1) % 4 : tone;
        next.dataset.tone = String(portraitTone);
        portrait.setAttribute("aria-label", "Portrait unavailable for " + rows[index].getAttribute("aria-label"));
        profile.hidden = true;
        showPortrait(next);
      }

      if (reducedMotion.matches) return;
      rows[index].querySelectorAll(".team-roster-segment i").forEach((segment, position) => {
        segment.getAnimations().forEach((animation) => animation.cancel());
        segment.animate(
          [{ transform: "translateY(0)" }, { transform: "translateY(-100%)" }],
          { duration: 230, delay: position * 11, easing: easeOut },
        );
      });
    }

    function selectTab(index: number) {
      if (selectedTab === index) return;
      selectedTab = index;
      tabs.forEach((tab, position) => {
        tab.setAttribute("aria-selected", String(index === position));
        tab.tabIndex = index === position ? 0 : -1;
        tab.querySelector(".team-roster-tab-highlight")?.toggleAttribute("data-glass-highlight", index === position);
      });
      panel.setAttribute("aria-labelledby", tabs[index].id);

      const opacity = getComputedStyle(list).opacity;
      listMotion?.cancel();
      const swap = () => {
        const changed = displayedTab !== index;
        displayedTab = index;
        lists.forEach((group, position) => { group.hidden = position !== index; });
        list.scrollTop = 0;
        const dense = lists[index].hasAttribute("data-dense");
        panel.toggleAttribute("data-dense", dense);
        if (changed) selectRow(0, true);
      };
      if (reducedMotion.matches) {
        swap();
        return;
      }

      const exit = list.animate([{ opacity }, { opacity: 0 }], { duration: 70, fill: "forwards" });
      listMotion = exit;
      exit.onfinish = () => {
        if (listMotion !== exit) return;
        swap();
        exit.cancel();
        listMotion = list.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 180, easing: easeOut });
      };
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(index));
      tab.addEventListener("keydown", (event) => {
        let next;
        switch (event.key) {
          case "ArrowLeft": next = (index + tabs.length - 1) % tabs.length; break;
          case "ArrowRight": next = (index + 1) % tabs.length; break;
          case "Home": next = 0; break;
          case "End": next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        tabs[next].focus();
        selectTab(next);
      });
    });

    rowSets.forEach((rows) => rows.forEach((row, index) => {
      row.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") selectRow(index);
      });
      row.addEventListener("focus", () => selectRow(index));
      row.addEventListener("click", () => selectRow(index));
    }));
    roster.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) => {
      button.addEventListener("click", () => {
        const count = rowSets[displayedTab].length;
        selectRow((selectedRow + Number(button.dataset.step) + count) % count);
        rowSets[displayedTab][selectedRow].scrollIntoView({ block: "nearest" });
      });
    });
  }
</script>

<style>
  .team-roster {
    width: min(100% - clamp(32px, 8vw, 112px), 1440px);
    height: calc(100dvh - var(--site-header-height) - var(--site-bottom-nav-space, 0px));
    min-height: 340px;
    margin-inline: auto;
    padding-block: clamp(12px, 2.5dvh, 28px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(14px, 2.8dvh, 28px);
    --roster-rule: #353135;
    --roster-motion: var(--color-tedx);
  }
  .team-roster-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    flex-wrap: wrap;
  }
  .team-roster-header h1 {
    font-size: clamp(2.5rem, min(5.2vw, 9dvh), 5.25rem);
    letter-spacing: -.04em;
    line-height: 1;
  }
  .team-roster-header :global(.team-roster-tabs) {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    max-width: 100%;
    gap: 4px;
    padding: 4px;
    border-radius: 28px;
    background: #211b21a8;
    backdrop-filter: blur(14px);
  }
  .team-roster-header :global(astro-island),
  .team-roster-header :global(astro-slot) { display: contents; }
  .team-roster-header button[role="tab"] {
    position: relative;
    min-height: 44px;
    padding-inline: clamp(8px, .9vw, 14px);
    border-radius: 999px;
    color: #c5c0c3;
    font-size: .82rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .team-roster-header button[role="tab"]:hover,
  .team-roster-header button[aria-selected="true"] { color: white; }
  .team-roster-tab-highlight[data-glass-highlight] {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--roster-motion);
  }
  .team-roster-header :global([data-glass-moving]) .team-roster-tab-highlight { opacity: 0; }
  .team-roster-tab-label { position: relative; z-index: 2; }
  @media (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    .team-roster-header :global(.team-roster-tabs[data-glass-ready]) { touch-action: none; }
  }
  .team-roster button { cursor: pointer; }
  .team-roster :is(button, a):focus-visible { outline: 2px solid white; outline-offset: 3px; }
  .team-roster-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.26fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    align-items: start;
    gap: clamp(24px, 4.6vw, 64px);
  }
  .team-roster-lists { max-height: 100%; overflow-y: auto; }
  .team-roster-list { border-top: 1px solid var(--roster-rule); }
  .team-roster-panel[data-dense] { container-type: size; }
  .team-roster-panel[data-dense] .team-roster-lists { max-height: none; overflow: visible; }
  .team-roster-list[data-dense] .team-roster-row {
    min-height: min(56px, calc((100cqh - 1px) / var(--member-count)));
    gap: clamp(6px, 1vw, 16px);
  }
  .team-roster-list[data-dense] .team-roster-member-name {
    font-size: clamp(.84rem, min(2vw, 4.3cqh), 1.65rem);
  }
  .team-roster-list[data-dense] .team-roster-member-role { font-size: clamp(.66rem, 1.05vw, .84rem); }
  .team-roster-row {
    width: 100%;
    min-height: clamp(44px, 8dvh, 72px);
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    padding-inline: 10px;
    border-bottom: 1px solid var(--roster-rule);
    text-align: start;
  }
  .team-roster-row[aria-current="true"] { border-bottom-color: var(--roster-motion); }
  .team-roster-arrow { width: 20px; opacity: 0; color: var(--roster-motion); }
  .team-roster-row[aria-current="true"] .team-roster-arrow { opacity: 1; }
  .team-roster-segment { flex: 1; overflow: hidden; }
  .team-roster-segment i, .team-roster-segment i::after {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--placeholder-fill);
  }
  .team-roster-segment i::after { content: ""; transform: translateY(100%); }
  .team-roster-member { color: #c5c0c3; }
  .team-roster-member[aria-current="true"] { color: white; }
  .team-roster-member-name {
    display: flex;
    flex-wrap: wrap;
    column-gap: .28em;
    font-size: clamp(1.125rem, 2.5vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -.035em;
  }
  .team-roster-word { display: inline-flex; }
  .team-roster-word .team-roster-segment { flex: none; }
  .team-roster-word .team-roster-segment i {
    position: relative;
    font-style: normal;
  }
  .team-roster-word .team-roster-segment i::after {
    position: absolute;
    inset: 0;
    content: attr(data-letter);
  }
  .team-roster-member-role {
    display: grid;
    color: #bcb6ba;
    font-size: clamp(.7rem, 1.05vw, .88rem);
    line-height: 1.3;
    text-align: end;
  }
  .team-roster-feature {
    align-self: stretch;
    container-type: size;
  }
  .team-roster-picture, .team-roster-navigation { width: min(100%, calc((100cqh - 50px) * .8)); }
  .team-roster-picture { position: relative; }
  .team-roster-portrait {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--roster-rule);
    border-radius: 4px;
    background: #131215;
  }
  .team-roster-image {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #18171a;
    color: #777277;
  }
  .team-roster-image[data-tone="1"] { background: #232124; }
  .team-roster-image[data-tone="2"] { background: #141315; }
  .team-roster-image[data-tone="3"] { background: #201e21; }
  .team-roster-image svg { width: 27%; max-width: 120px; }
  .team-roster-image > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .team-roster-profile {
    position: absolute;
    inset: auto auto 8px 8px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid #ffffff38;
    border-radius: 4px;
    background: #100e11;
    color: white;
  }
  .team-roster-profile[hidden] { display: none; }
  .team-roster-profile:hover { background: var(--roster-motion); }
  .team-roster-profile svg { width: 24px; }
  .team-roster-navigation {
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    margin-top: 6px;
  }
  .team-roster-navigation button { display: grid; place-items: center; width: 44px; height: 44px; color: #c5c0c3; }
  .team-roster-navigation button:hover { color: white; }
  .team-roster-navigation svg { width: 20px; }

  @media (max-width: 720px) {
    .team-roster-header { justify-content: center; }
    .team-roster-header :global(.team-roster-tabs) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: min(100%, 390px);
    }
    .team-roster-header button[role="tab"] { padding-inline: 0; font-size: clamp(.68rem, 3.25vw, .82rem); }
    .team-roster-panel { gap: 14px; }
    .team-roster-row {
      min-height: 44px;
      grid-template-columns: 16px minmax(0, 1fr) auto;
      gap: 8px;
      padding-inline: 4px;
    }
    .team-roster-arrow { width: 16px; }
    .team-roster-member {
      grid-template-columns: 16px minmax(0, 1fr);
      gap: 3px 8px;
      padding-block: 8px;
    }
    .team-roster-member .team-roster-arrow { grid-row: span 2; }
    .team-roster-member-name { font-size: clamp(.94rem, 4vw, 1.25rem); }
    .team-roster-member-role { display: flex; flex-wrap: wrap; gap: 2px 5px; text-align: start; }
    .team-roster-member-role span + span::before { content: "·"; margin-right: 5px; }
  }

  @media (max-width: 720px) and (min-height: 680px) {
    .team-roster-lists { max-height: 26dvh; }
    .team-roster-panel {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }
    .team-roster-picture, .team-roster-navigation {
      width: min(100%, calc((100cqh - 50px) * 4 / 3));
      margin-inline: auto;
    }
    .team-roster-portrait { aspect-ratio: 4 / 3; }
  }

  @media (max-width: 720px) and (max-height: 640px) {
    .team-roster:has(.team-roster-panel[data-dense]) { gap: 10px; }
  }
  @media (max-width: 720px) {
    .team-roster-panel[data-dense] {
      grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr);
    }
    .team-roster-panel[data-dense] .team-roster-portrait { aspect-ratio: 4 / 5; }
    .team-roster-list[data-dense] .team-roster-row {
      grid-template-columns: 12px minmax(0, 1fr);
      gap: 0 4px;
      padding-block: 1px;
    }
    .team-roster-list[data-dense] .team-roster-arrow { width: 12px; }
    .team-roster-list[data-dense] .team-roster-member-name {
      font-size: clamp(.69rem, 3.2vw, .94rem);
    }
    .team-roster-list[data-dense] .team-roster-member-role { font-size: .61rem; }
  }
  @media (max-width: 360px) and (max-height: 640px) {
    .team-roster-list[data-dense] .team-roster-member .team-roster-arrow { grid-row: auto; }
    .team-roster-list[data-dense] .team-roster-member-role { display: none; }
  }
</style>
