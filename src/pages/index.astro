<style>
  .home-countdown {
    color: #eae7e8;
    scroll-margin-top: calc(var(--site-header-height) + 12px);
  }

  .countdown-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(20px, 5vw, 76px);
    width: min(100% - 2 * clamp(20px, 5vw, 76px), 1400px);
    margin-inline: auto;
    padding-block: clamp(24px, 4vw, 52px);
    border-block: 1px solid #2c272a;
  }

  .countdown-layout::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    background: var(--ticket-surface);
    transform: scaleX(var(--countdown-trace, 0));
    transform-origin: right center;
    pointer-events: none;
  }

  .countdown-layout h2 {
    margin: 0;
    font: 400 clamp(2rem, 4vw, 3.75rem)/1 var(--font-bebas);
  }

  #countdown {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }

  .count-box {
    display: flex;
    flex-direction: column-reverse;
    justify-content: center;
    align-items: center;
    min-width: 0;
    text-align: center;
    border-left: 1px solid #2c272a;
    gap: 6px;
  }

  .count-box:first-child {
    border-left: 0;
  }

  .count-box dt {
    color: #aaa8ad;
    font-size: clamp(.65rem, 1.15vw, .85rem);
    text-transform: capitalize;
  }

  .count-box dd {
    margin: 0;
    font-size: clamp(1.55rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    .countdown-layout {
      grid-template-columns: 1fr;
    }
  }
</style>






<div data-north-waypoint><SponsorsComponent client:visible /></div>


