export async function getStaticPaths() {
  return [
    { params: { speaker: "dr-tanu-jain" } },
    { params: { speaker: "gunjan-saini" } },
    { params: { speaker: "preksha-kaparwan" } },
    { params: { speaker: "deepak-pareek" } },
    { params: { speaker: "chinmay-gaur" } },
    { params: { speaker: "dr-ajay-data" } },
    { params: { speaker: "krishnan-sunderarajan" } },
    { params: { speaker: "dr-lopa-mudraa" } },
    { params: { speaker: "dr-kamna-chhibber" } },
    { params: { speaker: "aabha-hanjura" } },
    { params: { speaker: "chetna-balhara" } },
    { params: { speaker: "shelly-jyoti" } }
  ];
}



const { speaker } = Astro.params;
const talk = talks.find(t => t.speaker === speaker);
if (!talk) throw new Error("Talk not found");

function getEmbedUrl(url) {
  if (url.includes("drive.google.com")) {
    const id = url.match(/\/d\/(.+?)\//)?.[1];
    return `https://drive.google.com/file/d/${id}/preview`;
  }
  return url.replace("watch?v=", "embed/").replace("youtu.be/", "www.youtube.com/embed/");
}

const embedUrl = getEmbedUrl(talk.url);
const canonical = `https://www.tedxlnmiit.in/talks/${talk.speaker}`;
---

<MainLayout
  title={`${talk.name} | TEDx LNMIIT`}
  description={talk.description}
  canonical={canonical}
>
  <script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": talk.name,
    "thumbnailUrl": `https://www.tedxlnmiit.in${talk.image}`,
    "description": talk.description,
    "contentUrl": talk.url,
    "embedUrl": embedUrl,
    "uploadDate": `${talk.uploadDate}T00:00:00+05:30`,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonical
    },
    "publisher": {
      "@type": "Organization",
      "name": "TEDxLNMIIT"
    },
    "potentialAction": {
      "@type": "WatchAction",
      "target": embedUrl
    }
  })}
></script>


 <main class="max-w-5xl mx-auto py-12 px-4 text-white">

  <!-- VIDEO MUST BE FIRST -->
  <div class="aspect-video rounded-xl overflow-hidden shadow-xl">
    <iframe
      src={embedUrl}
      class="w-full h-full"
      loading="eager"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>
  </div>

  <h1 class="text-3xl font-bold mt-6 mb-4">{talk.name}</h1>

  <p class="text-lg text-gray-300">{talk.description}</p>

</main>

</MainLayout>
