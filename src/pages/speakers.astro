  <SpeakersCarousel client:load />


  <div class="my-12 text-center">
    <a class="inline-block rounded-lg border border-white/30 px-6 py-3 text-white hover:border-[#eb0028]" href="/past-speakers">
      Browse Past Speakers
    </a>
  </div>
</MainLayout>
