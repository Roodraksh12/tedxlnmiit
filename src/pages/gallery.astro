---

// component imports 
import MainLayout from "../layouts/MainLayout.astro";

import Gallery from "../components/gallery/Gallery.jsx";

---

<MainLayout title="Gallery | TEDxLNMIIT" description="Explore the vibrant moments captured at TEDxLNMIIT through our gallery, showcasing inspiring talks, engaging activities, and memorable experiences.">
    
     <Gallery />
	
</MainLayout>

<style is:global>
  .gallery-photo-lead {
    position: relative;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery-collection:target .gallery-photo-lead img {
      animation: gallery-photo-reveal .54s cubic-bezier(.16, 1, .3, 1);
    }

    .gallery-collection:target .gallery-photo-lead::after {
      content: '';
      position: absolute;
      inset: 1px;
      border: 1px solid var(--color-tedx);
      border-radius: inherit;
      pointer-events: none;
      animation: gallery-outline-draw .54s ease-out both;
    }
  }

  @keyframes gallery-photo-reveal {
    from {
      clip-path: polygon(0 0, 100% 0, 100% 9%, 65% 5%, 38% 18%, 0 11%);
      filter: saturate(.25);
    }
    to {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 65% 100%, 38% 100%, 0 100%);
      filter: saturate(1);
    }
  }

  @keyframes gallery-outline-draw {
    0% { clip-path: inset(0 100% 90% 0); opacity: 0; }
    24% { clip-path: inset(0 0 82% 0); opacity: 1; }
    65% { clip-path: inset(0); opacity: .8; }
    100% { clip-path: inset(0); opacity: 0; }
  }
</style>
