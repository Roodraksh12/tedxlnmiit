---
import MainLayout from '../layouts/MainLayout.astro';
import { speakerEditions } from '../data/pastSpeakers.js';
import { ArrowDown, ArrowUpRight, Play, Plus } from 'lucide-react';
---
<MainLayout title="Past Speakers | TEDxLNMIIT" description="Explore past TEDxLNMIIT editions, meet the speakers, and watch their talks.">
  <div class="archive">
    <div class="archive-program" id="speaker-editions">
      <div class="archive-wrap">
        <h1 class="sr-only">Past Speakers</h1>
        <nav class="edition-nav" aria-label="Speaker editions">
          <span class="edition-label" aria-hidden="true">Browse by year</span>
          <ul>
            {speakerEditions.map(edition => (
              <li><a href={`#${edition.id}`} data-edition-link={edition.id}>{edition.year}</a></li>
            ))}
          </ul>
        </nav>

        {speakerEditions.map((edition, index) => {
          const featured = edition.speakers[0];
          return (
            <section id={edition.id} class="edition" data-edition aria-labelledby={`theme-${edition.id}`}>
              <header class="intro-layout">
                <div class="intro-copy">
                  <h2 id={`theme-${edition.id}`}>{edition.theme || `${edition.year} archive`}<span aria-hidden="true">.</span></h2>
                  {featured ? (
                    <a class="intro-link" href={`#lineup-${edition.id}`}>
                      Explore the lineup <ArrowDown size={16} aria-hidden="true" />
                    </a>
                  ) : (
                    <p>The speaker lineup for this edition is unavailable.</p>
                  )}
                </div>
                {featured?.image && (
                  <figure class="featured-speaker">
                    <img src={featured.image} alt="" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} />
                    <figcaption>{featured.name}</figcaption>
                  </figure>
                )}
              </header>
              {edition.speakers.length > 0 && <>
                <header class="edition-heading">
                  <h3 id={`lineup-${edition.id}`}>{edition.year} speakers</h3>
                  <p>{edition.speakers.length} speakers</p>
                </header>
                <ul class="speaker-list">
                  {edition.speakers.map(speaker => (
                    <li class="speaker">
                      <div class="speaker-image">
                        {speaker.image && <img src={speaker.image} alt="" width="600" height="680" loading="lazy" decoding="async" />}
                      </div>
                      <h4>{speaker.name}</h4>
                      <div class="speaker-links">
                        {speaker.youtube && (
                          <a class="watch-link" href={speaker.youtube} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${speaker.name}’s talk`}>
                            <Play size={14} aria-hidden="true" /> Watch talk
                          </a>
                        )}
                        {speaker.instagram && (
                          <a href={speaker.instagram} target="_blank" rel="noopener noreferrer" aria-label={`${speaker.name} on Instagram`}>
                            Instagram <ArrowUpRight size={14} aria-hidden="true" />
                          </a>
                        )}
                        {speaker.linkedin && (
                          <a href={speaker.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${speaker.name} on LinkedIn`}>
                            LinkedIn <ArrowUpRight size={14} aria-hidden="true" />
                          </a>
                        )}
                      </div>
                      <details>
                        <summary aria-label={`Biography of ${speaker.name}`}>Biography <Plus size={17} aria-hidden="true" /></summary>
                        <p>{speaker.description}</p>
                      </details>
                    </li>
                  ))}
                </ul>
              </>}
            </section>
          );
        })}
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const editionLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-edition-link]')];
  const editions = [...document.querySelectorAll<HTMLElement>('[data-edition]')];
  const defaultEdition = editions[0]?.id;

  function selectEdition(id: string | undefined) {
    for (const edition of editions) {
      edition.hidden = edition.id !== id;
    }

    for (const link of editionLinks) {
      if (link.dataset.editionLink === id) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    }
  }

  function syncEdition() {
    const id = location.hash.slice(1).replace(/^lineup-/, '');
    selectEdition(editions.some(edition => edition.id === id) ? id : defaultEdition);
  }

  for (const link of editionLinks) {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      event.preventDefault();
      if (location.hash !== link.hash) history.pushState(null, '', link.hash);
      selectEdition(link.dataset.editionLink);
    });
  }

  syncEdition();
  window.addEventListener('hashchange', syncEdition);
</script>

<style>
  .archive {
    --archive-raised: #111012;
    --archive-text: #eae7e8;
    --archive-muted: #aaa8ad;
    --archive-line: #2c272a;
    --archive-red: var(--ticket-surface);
    --archive-link: var(--color-tedx);
    color: var(--archive-text);
  }

  .archive ::selection {
    background: var(--color-tedx);
    color: #fff;
  }

  .archive :is(a, summary):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .archive-wrap {
    width: min(100% - 2 * clamp(20px, 5vw, 76px), 1400px);
    margin-inline: auto;
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, .88fr) minmax(0, 1.32fr);
    align-items: center;
    gap: clamp(24px, 5vw, 76px);
    padding-block: clamp(30px, 4.2vw, 64px);
    border-bottom: 1px solid var(--archive-line);
  }

  .intro-copy h2 {
    margin: 0;
    font: 400 clamp(3.25rem, 7vw, 6rem)/.89 var(--font-bebas);
    letter-spacing: -.015em;
    text-wrap: balance;
  }

  .intro-copy h2 span {
    color: var(--archive-link);
  }

  .intro-copy p {
    max-width: 31ch;
    margin: 22px 0 16px;
    color: var(--archive-muted);
    font-size: clamp(.9rem, 1.35vw, 1.04rem);
    line-height: 1.65;
  }

  .intro-link, .speaker-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 4px;
  }

  .intro-link {
    gap: 11px;
    margin-top: 16px;
    font-size: .86rem;
    text-decoration: underline;
    text-decoration-color: var(--archive-link);
  }

  .intro-link:hover, .intro-link svg {
    color: var(--archive-link);
  }

  .featured-speaker {
    margin: 0;
  }

  .featured-speaker img, .speaker-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-speaker img {
    height: auto;
    aspect-ratio: 16 / 10;
    object-position: center 25%;
    background: var(--archive-raised);
  }

  .featured-speaker figcaption {
    padding-top: 10px;
    color: var(--archive-muted);
    font-size: .8rem;
  }

  .archive-program {
    padding-bottom: clamp(64px, 8vw, 120px);
  }

  .archive-program, .edition-heading h3 {
    scroll-margin-top: var(--site-header-height);
  }

  .edition {
    scroll-margin-top: calc(var(--site-header-height) + 70px);
  }

  .edition-nav {
    display: flex;
    align-items: stretch;
    gap: clamp(24px, 5vw, 72px);
    border-bottom: 1px solid var(--archive-line);
  }

  .edition-label {
    align-self: center;
    color: var(--archive-muted);
    font-size: .78rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .edition-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(8px, 2.5vw, 36px);
  }

  .edition-nav a {
    display: grid;
    place-items: center;
    min-height: 66px;
    padding-inline: 12px;
    border-bottom: 3px solid transparent;
    color: var(--archive-muted);
    font-size: clamp(.85rem, 1.5vw, 1.05rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .edition-nav a:hover, .edition-nav a[aria-current] {
    color: var(--archive-link);
  }

  .edition-nav a[aria-current] {
    border-color: var(--archive-red);
  }

  .edition + .edition:not([hidden]) {
    margin-top: clamp(24px, 4vw, 56px);
  }

  .edition-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
    padding-block: clamp(27px, 3.8vw, 56px) clamp(18px, 2.4vw, 34px);
  }

  .edition-heading h3 {
    margin: 0;
    font: 400 clamp(2.5rem, 5.5vw, 4.5rem)/.95 var(--font-bebas);
    text-wrap: balance;
  }

  .edition-heading p {
    margin: 0;
    color: var(--archive-muted);
    font-size: .85rem;
    white-space: nowrap;
  }

  .speaker-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(27px, 4vw, 56px) clamp(16px, 2.5vw, 36px);
  }

  .speaker-image {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--archive-raised);
  }

  .speaker-image img {
    object-position: center 25%;
  }

  .speaker h4 {
    margin: 12px 0 0;
    font-size: clamp(1.05rem, 2vw, 1.55rem);
    font-weight: 600;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .speaker-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 16px;
  }

  .speaker-links a {
    font-size: .8rem;
  }

  .speaker-links .watch-link, .speaker-links a:hover, summary:hover {
    color: var(--archive-link);
  }

  .speaker-links a:hover {
    text-decoration: underline;
  }

  .speaker details {
    border-top: 1px solid var(--archive-line);
  }

  .speaker summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 44px;
    font-size: .8rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .speaker summary::-webkit-details-marker {
    display: none;
  }

  .speaker details[open] summary svg {
    transform: rotate(45deg);
  }

  .speaker details p {
    color: var(--archive-muted);
    font-size: .9rem;
    line-height: 1.7;
  }

  .speaker details p {
    margin: 0 0 12px;
  }

  @media (max-width: 740px) {
    .intro-layout {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .edition-nav {
      gap: 0;
    }

    .edition-label {
      display: none;
    }

    .edition-nav ul {
      display: grid;
      width: 100%;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .edition-nav a {
      min-height: 54px;
      padding-inline: 2px;
    }

    .speaker-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 410px) {
    .edition-heading {
      flex-wrap: wrap;
    }

    .speaker h4 {
      min-height: 2.4em;
    }
  }
</style>
