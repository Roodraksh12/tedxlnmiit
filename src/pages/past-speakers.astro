---
import MainLayout from '../layouts/MainLayout.astro';
import { speakerEditions } from '../data/pastSpeakers.js';
const fanAngles = [-27, -15, 0, 11];
const fanHeights = [.24, .08, 0, .025];
const suits = ['♦', '♣', '♥', '♠'];
const accents=['#ff3957','#eb244a','#d91b40'];
---
<MainLayout title="Past Speakers | TEDxLNMIIT" description="Explore past TEDxLNMIIT editions and discover each speaker's story.">
<main class="archive">
 <section id="edition-picker" aria-labelledby="archive-title">
  <h1 id="archive-title" class="sr-only">Past Speakers</h1>
  <div class="year-grid">
   {speakerEditions.map((edition,i)=><button class="year-card" data-open={edition.id}
    style={`--card-index:${i};--column:${i%2};--row:${Math.floor(i/2)};--fan-angle:${fanAngles[i]}deg;--fan-height:${fanHeights[i]};--suit-color:${i%2 ? '#161318' : '#b50024'}`}
    aria-label={`Browse ${edition.year} past speakers`} aria-controls={`edition-${edition.id}`}>
    <span class="card-corner" aria-hidden="true">{edition.year}<b>{suits[i]}</b></span>
    <span class="card-suit" aria-hidden="true">{suits[i]}</span>
    <span class="card-corner card-corner-bottom" aria-hidden="true">{edition.year}<b>{suits[i]}</b></span>
   </button>)}
  </div>
 </section>
 {speakerEditions.map((edition,yearIndex)=><section id={`edition-${edition.id}`} class="edition" data-edition={edition.id} hidden style={`--accent:${accents[yearIndex%3]};--steps:${edition.speakers.length}`}>
  <div class="edition-toolbar"><button data-back>← Back to years</button><span>{edition.year} / TEDxLNMIIT</span></div>
  <div class="speaker-scroll">
   <div class="speaker-stage">
    <header class="edition-header"><h2 class="eyebrow" tabindex="-1">{edition.year} · {edition.theme || "Past Speakers"}</h2><p class="scroll-cue">SCROLL TO MEET THE NEXT SPEAKER ↓</p></header>
    {edition.speakers.length ? <>
    <div class="speaker-deck">
     {edition.speakers.map((speaker,i)=><article class:list={['speaker-slide',{'is-active':i===0}]} data-slide aria-hidden={i!==0?'true':undefined} inert={i!==0}>
      <div class="speaker-copy"><h3>{speaker.name}</h3><p class="speaker-bio">{speaker.description}</p><div class="speaker-links">{speaker.youtube&&<a href={speaker.youtube} target="_blank" rel="noopener noreferrer">Watch talk ↗</a>}{speaker.instagram&&<a href={speaker.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}{speaker.linkedin&&<a href={speaker.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}</div></div>
      <div class="portrait"><span class="portrait-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>{speaker.image ? <img src={speaker.image} alt={speaker.name} width="600" height="680" loading="lazy"/> : <span class="portrait-placeholder" aria-hidden="true">{speaker.name.split(" ").filter(word => word !== "Dr.").map(word => word[0]).slice(0,2).join("")}</span>}<span class="scan-line" aria-hidden="true"></span></div>
     </article>)}
    <div class="burn-front" aria-hidden="true"><span class="burn-core"></span>{Array.from({length:28},(_,i)=><i style={`--x:${(i*37)%100}%;--delay:${(i%7)*-.12}s;--drift:${(i%2?1:-1)*(10+i%19)}px;--life:${.6+i%5*.13}s`}></i>)}</div>
    </div>
    <nav class="speaker-controls" aria-label={`Browse ${edition.year} speakers`}><button data-prev aria-label="Previous speaker">←</button><p class="counter" aria-live="polite" aria-atomic="true"><span data-counter>01</span> / {String(edition.speakers.length).padStart(2,'0')}</p><button data-next aria-label="Next speaker">→</button></nav>
    </> : <p class="empty">The speaker lineup for this edition has not been added yet.</p>}
   </div>
  </div>
  <button class="end-back" data-back>Explore another year ↗</button>
 </section>)}
 <noscript><p>Please enable JavaScript to browse the speaker editions.</p></noscript>
</main>
</MainLayout>
<style>
.archive{max-width:1360px;margin:auto;padding:70px 40px 100px;color:#f7f4f1}.archive [hidden]{display:none!important}.eyebrow{font-size:11px;letter-spacing:.18em;color:#b6a6ab;text-transform:uppercase}.year-grid{--card-width:clamp(115px,25vw,240px);position:relative;min-height:clamp(230px,49vw,465px);margin-inline:auto;max-width:690px}
.year-card{position:absolute;top:10%;left:calc(50% - var(--card-width)*.5 + (var(--card-index) - 1.5)*var(--card-width)*.55);width:var(--card-width);aspect-ratio:5/7;transform:rotate(var(--fan-angle));transform-origin:50% 85%;border-radius:12px;border:1px solid #c5bec3;background:linear-gradient(145deg,#fff,#eae5e8);color:var(--suit-color);box-shadow:-6px 9px 22px #0007;transition:transform .25s ease}
.year-card::before{content:'';position:absolute;inset:11px;border:1px solid currentColor;border-radius:7px;opacity:.5;pointer-events:none}
.card-corner{position:absolute;top:16px;left:17px;display:grid;justify-items:start;background:#fbf9fa;padding:0 3px;font-size:clamp(11px,2vw,18px);font-weight:700;line-height:1.08}
.card-corner b{font-size:1.25em}.card-corner-bottom{inset:auto 17px 16px auto;transform:rotate(180deg)}
.card-suit{display:grid;place-items:center;height:100%;font-size:clamp(3rem,9vw,7rem)}
.edition-toolbar{display:flex;justify-content:space-between;align-items:center;gap:20px;margin:0 0 26px;font-size:12px;color:#bfb3bb}.edition-toolbar button,.end-back{padding:12px 0;color:white}.edition-toolbar button:hover,.end-back:hover{color:var(--accent)}.speaker-stage{max-width:1200px;margin-inline:auto;border-top:1px solid #ffffff25;background:linear-gradient(125deg,#100c10f5,#09090be8);padding:28px 30px;border-radius:4px 4px 18px 18px}.edition-header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:22px}.edition-header h2{font-size:12px;margin:0;font-weight:500;letter-spacing:.16em}.scroll-cue{display:none;font-size:9px;letter-spacing:.15em;color:#ad999f;white-space:nowrap}.speaker-deck{position:relative;display:grid}.speaker-slide{position:relative;grid-area:1/1;display:none;grid-template-columns:1fr 1fr;gap:45px;align-items:center}.speaker-slide.is-active{display:grid;animation:speaker-in .65s ease both}.speaker-copy{padding:20px 0}.speaker-copy h3{font-family:Georgia,serif;font-size:clamp(2.3rem,4.4vw,4.8rem);font-weight:400;line-height:1.04;letter-spacing:-.05em;margin:18px 0 26px}.speaker-links{display:flex;flex-wrap:wrap;gap:18px;margin-top:25px;font-size:12px;color:var(--accent)}.speaker-links a:hover{text-decoration:underline}.portrait{position:relative;height:420px;overflow:hidden;border:1px solid #ffffff15;background:radial-gradient(ellipse at center bottom,color-mix(in srgb,var(--accent) 13%,#111),#09090b);border-radius:8px}.portrait img{height:100%;width:100%;display:block;object-fit:contain;object-position:center center}.portrait-number{position:absolute;top:16px;right:20px;font-family:Georgia,serif;font-size:54px;color:#ffffff35}.scan-line{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--accent),#fff0e2,var(--accent),transparent);box-shadow:0 0 20px 5px var(--accent);pointer-events:none;opacity:0}.is-active .scan-line{animation:sweep .85s ease-out both}.speaker-controls{display:flex;align-items:center;gap:20px;border-top:1px solid #ffffff15;margin-top:24px;padding-top:18px}.speaker-controls>button{width:42px;height:42px;border:1px solid #ffffff25;border-radius:50%;color:white;font-size:20px}.speaker-controls button:disabled{opacity:.25;cursor:default}.speaker-controls button:not(:disabled):hover{color:var(--accent);border-color:var(--accent)}.speaker-dots{display:flex;gap:10px}.speaker-dots button{padding:9px 8px;font-size:11px;color:#9d8d96;border-bottom:2px solid #3b2b33}.speaker-dots button[aria-current]{color:var(--accent);border-color:var(--accent)}.counter{margin-left:auto;color:#897e85;font-size:12px}.counter span{font-family:Georgia,serif;font-size:26px;color:var(--accent)}.end-back{display:block;margin:28px auto 0}.empty{min-height:300px;display:grid;place-items:center;color:#bdb2b9}.archive button:focus-visible,.archive a:focus-visible{outline:2px solid #fff;outline-offset:5px}.archive button{cursor:pointer}
@media(min-width:700px) and (min-height:650px){.edition.is-enhanced .scroll-cue{display:block}.edition.is-enhanced .speaker-scroll{height:calc(var(--steps) * 95svh)}.is-enhanced .speaker-stage{position:sticky;top:95px;height:calc(90svh - 120px);display:flex;flex-direction:column}.is-enhanced .speaker-deck{flex:1;min-height:0}.is-enhanced .speaker-slide{height:100%}.is-enhanced .portrait{height:100%;min-height:0;width:100%;max-width:460px;justify-self:center}.is-enhanced .speaker-controls{flex-shrink:0}.is-enhanced .speaker-copy h3{font-size:clamp(2rem,3.5vw,3.8rem)}}
@media(max-width:1000px){.archive{padding-inline:24px}.speaker-slide{gap:25px}.speaker-copy h3{font-size:3rem}}
@media(max-width:700px){.archive{padding:40px 18px 65px}.speaker-stage{padding:22px 18px}.speaker-slide{grid-template-columns:1fr;gap:22px}.portrait{grid-row:1;height:300px}.speaker-copy{padding:0}.speaker-copy h3{font-size:38px;margin:14px 0 20px}.scroll-cue{display:none}.speaker-controls{gap:10px;flex-wrap:wrap}.speaker-dots{gap:2px}.speaker-dots button{padding-inline:6px}.counter{font-size:10px}.counter span{font-size:22px}.edition-toolbar{font-size:10px}.edition-header h2{font-size:11px}}


/* The erasure edge follows scroll position; the panel itself never moves. */
.speaker-slide.is-active,.speaker-slide.is-incoming{display:grid;animation:none;transform:none}.speaker-slide.is-incoming{pointer-events:none}
.speaker-slide::after,.scan-line{display:none!important}
.burn-front{position:absolute;left:0;right:0;top:var(--burn-y,0%);height:2px;transform:translateY(-1px);z-index:4;pointer-events:none;opacity:var(--burn-visible,0)}
.burn-core{display:block;height:2px;background:linear-gradient(90deg,transparent 0%,#eb0028 15%,#fff1e7 50%,#ff244a 85%,transparent);box-shadow:0 0 8px 2px #ff1744aa,0 -6px 24px 7px #eb00284d}
.burn-front i{position:absolute;left:var(--x);top:-2px;width:2px;height:2px;background:#ffcfbf;border-radius:50%;box-shadow:0 0 5px #ff1744;animation:ember-rise var(--life) linear infinite;animation-delay:var(--delay)}
@keyframes ember-rise{0%{opacity:0;transform:translate(0,0)}20%{opacity:1}100%{opacity:0;transform:translate(var(--drift),-42px)}}
.edition-header h2:focus{outline:none}
@media(prefers-reduced-motion:reduce){.archive *{animation:none!important;transition:none!important}.scroll-cue{display:none}}
#edition-picker{--spread:0;--card-width:clamp(96px,min(23vw,22svh),175px);--card-gap:clamp(18px,4vw,38px)}
.year-grid{--row-step:calc(var(--card-width)*1.4 + var(--card-gap));height:calc(var(--row-step)*2);min-height:0}
.year-card{top:calc(var(--row-step)/2);left:calc(50% - var(--card-width)/2);transform:translate(
 calc((var(--card-index) - 1.5)*var(--card-width)*.39*(1 - var(--spread)) + (var(--column) - .5)*(var(--card-width) + var(--card-gap))*var(--spread)),
 calc(var(--fan-height)*var(--card-width)*(1 - var(--spread)) + (var(--row) - .5)*var(--row-step)*var(--spread))
 ) rotate(calc(var(--fan-angle)*(1 - var(--spread))));transform-origin:top left;transition:box-shadow .24s,border-color .24s}
#edition-picker .card-corner{top:12px;left:9px;font-size:clamp(9px,1.15vw,15px);white-space:nowrap}
#edition-picker .card-corner-bottom{inset:auto 9px 12px auto}
@media(prefers-reduced-motion:no-preference) and (min-height:480px){
 #edition-picker{min-height:135svh}
 .year-grid{position:sticky;top:105px}
}
@media(prefers-reduced-motion:reduce),(max-height:479px){#edition-picker{--spread:1!important}}
.speaker-bio{font-size:clamp(14px,1.25vw,17px);line-height:1.55;color:#d8ccd1}
.portrait-placeholder{display:grid;place-items:center;height:100%;font:clamp(4rem,12vw,9rem) Georgia,serif;color:var(--accent)}
@media(min-width:700px) and (min-height:650px){.is-enhanced .speaker-copy{max-height:100%;overflow:auto}}
</style>
<script>
const picker=document.querySelector<HTMLElement>('#edition-picker')!;
const editions=[...document.querySelectorAll<HTMLElement>('[data-edition]')];
const wide=matchMedia('(min-width:700px) and (min-height:650px)');
const motion=matchMedia('(prefers-reduced-motion:reduce)');
let selected:HTMLElement|null=null,index=0,frame=0,manualFrame=0;
const slides=()=>selected?[...selected.querySelectorAll<HTMLElement>('[data-slide]')]:[];
function paint(next:number){const cards=slides();if(!cards.length)return;index=Math.max(0,Math.min(cards.length-1,next));cards.forEach((card,i)=>{card.classList.remove('is-incoming');card.style.maskImage='none';card.style.webkitMaskImage='none';card.classList.toggle('is-active',i===index);card.inert=i!==index;card.setAttribute('aria-hidden',String(i!==index))});selected!.querySelectorAll('[data-step]').forEach((button,i)=>{if(i===index)button.setAttribute('aria-current','step');else button.removeAttribute('aria-current')});selected!.querySelector('[data-counter]')!.textContent=String(index+1).padStart(2,'0');(selected!.querySelector('[data-prev]') as HTMLButtonElement).disabled=index===0;(selected!.querySelector('[data-next]') as HTMLButtonElement).disabled=index===cards.length-1;}
const clamp=(value:number)=>Math.max(0,Math.min(1,value));
function burn(amount:number,revealing=false){
 if(!selected)return;
 const card=slides()[index],deck=selected.querySelector<HTMLElement>('.speaker-deck');
 if(!card||!deck)return;
 amount=clamp(amount);
 // Use the same physical edge for the mask and the light, even if the grid overflows.
 const cardRect=card.getBoundingClientRect(),deckRect=deck.getBoundingClientRect();
 const edge=amount*cardRect.height;
 const lightY=cardRect.top-deckRect.top+edge;
 const hidden=revealing?amount===0:amount===1;
 const full=revealing?amount===1:amount===0;
 const mask=hidden?'linear-gradient(transparent,transparent)':full?'none':revealing?`linear-gradient(to bottom,#000 ${edge}px,transparent ${edge}px)`:`linear-gradient(to bottom,transparent ${edge}px,#000 ${edge}px)`;
 card.style.maskImage=mask;card.style.webkitMaskImage=mask;
 card.inert=hidden;card.setAttribute('aria-hidden',String(hidden));
 deck.style.setProperty('--burn-y',`${lightY}px`);
 deck.style.setProperty('--burn-visible',amount>0&&amount<1?'1':'0');
}
function renderPosition(position:number){
 const cards=slides();if(!cards.length)return;
 const next=Math.min(cards.length-1,Math.floor(position));
 if(next!==index)paint(next);
 const phase=position-next;
 // Each speaker is revealed, held for reading, then fully erased before the next reveal.
 if(next>0&&phase<.25)burn(phase/.25,true);
 else if(phase<.55)burn(0);
 else burn(clamp((phase-.55)/.40));
}
function resetTransition(){cancelAnimationFrame(manualFrame);manualFrame=0;slides().forEach(card=>{card.style.maskImage='none';card.style.webkitMaskImage='none';card.classList.remove('is-incoming')});burn(0)}
function update(){frame=0;if(!selected){
 const distance=Math.max(1,window.innerHeight*.48);
 const progress=clamp(scrollY/distance);
 picker.style.setProperty('--spread',String(progress*progress*(3-2*progress)));
 return;
 }const enhanced=wide.matches&&!motion.matches&&slides().length>0;selected.classList.toggle('is-enhanced',enhanced);if(enhanced&&!manualFrame){const track=selected.querySelector<HTMLElement>('.speaker-scroll')!,stage=selected.querySelector<HTMLElement>('.speaker-stage')!;const progress=clamp((95-track.getBoundingClientRect().top)/Math.max(1,track.offsetHeight-stage.offsetHeight));renderPosition(progress*Math.max(0,slides().length-.01))}}
function schedule(){if(!frame)frame=requestAnimationFrame(update)}
function go(next:number){
 if(!selected||manualFrame)return;
 next=Math.max(0,Math.min(slides().length-1,next));if(next===index)return;
 if(selected.classList.contains('is-enhanced')){const track=selected.querySelector<HTMLElement>('.speaker-scroll')!,stage=selected.querySelector<HTMLElement>('.speaker-stage')!;window.scrollTo({top:scrollY+track.getBoundingClientRect().top-95+(track.offsetHeight-stage.offsetHeight)*(next+.40)/(slides().length-.01),behavior:'smooth'});return}
 if(motion.matches){paint(next);burn(0);return}
 const started=performance.now();
 let switched=false;
 const animate=(now:number)=>{
   const elapsed=now-started;
   if(elapsed<700)burn(elapsed/700);
   else if(elapsed<820)burn(1);
   else {if(!switched){paint(next);switched=true}burn(clamp((elapsed-820)/700),true)}
   if(elapsed<1520)manualFrame=requestAnimationFrame(animate);
   else {burn(0);manualFrame=0}
 };
 manualFrame=requestAnimationFrame(animate);
}
function openEdition(id:string){const section=editions.find(e=>e.dataset.edition===id);if(!section)return;picker.hidden=true;editions.forEach(e=>e.hidden=e!==section);resetTransition();selected=section;index=0;paint(0);section.classList.toggle('is-enhanced',wide.matches&&!motion.matches&&slides().length>0);window.scrollTo({top:0,behavior:'instant'});section.querySelector<HTMLElement>('h2')?.focus({preventScroll:true});history.replaceState(null,'',`#${id}`);schedule()}
function back(){resetTransition();const id=selected?.dataset.edition;editions.forEach(e=>e.hidden=true);selected=null;picker.hidden=false;history.replaceState(null,'',location.pathname);window.scrollTo({top:0,behavior:'instant'});document.querySelector<HTMLElement>(`[data-open="${id}"]`)?.focus({preventScroll:true})}
document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach(button => {
 button.addEventListener('click', () => openEdition(button.dataset.open!));
});
editions.forEach(section=>{section.querySelectorAll('[data-back]').forEach(button=>button.addEventListener('click',back));section.querySelectorAll<HTMLElement>('[data-step]').forEach(button=>button.addEventListener('click',()=>go(Number(button.dataset.step))));section.querySelector('[data-prev]')?.addEventListener('click',()=>go(index-1));section.querySelector('[data-next]')?.addEventListener('click',()=>go(index+1));section.addEventListener('keydown',event=>{if(event.key==='ArrowRight'){event.preventDefault();go(index+1)}if(event.key==='ArrowLeft'){event.preventDefault();go(index-1)}if(event.key==='Escape')back()})});
window.addEventListener('scroll',schedule,{passive:true});window.addEventListener('resize',schedule);wide.addEventListener('change',schedule);motion.addEventListener('change',schedule);
if(location.hash)openEdition(location.hash.slice(1));
schedule();
</script>
