---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Page Not Found" description="404 - The page you are looking for does not exist.">
  <section class="min-h-screen flex flex-col items-center justify-center text-center px-6">
    <div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Welp, this is awkward!
      </h1>
      <p class="text-lg text-gray-600 mb-8">
        We seem to have misplaced something…
      </p>

      <a
        href="/"
        class="inline-block px-6 py-3 text-[#EB0028] hover:text-white rounded-lg text-base font-medium hover:bg-red-700 transition"
      >
        Go Back Home
      </a>
    </div>
  </section>
</MainLayout>
